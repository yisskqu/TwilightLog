---
const path = Astro.url.pathname;
const links = [
  { href: "/", label: "首页" },
  { href: "/articles", label: "文章" },
  { href: "/photos", label: "摄影" },
  { href: "/search", label: "搜索" },
];

const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/">
      TwilightLog
      <small>暮光日志</small>
    </a>
    <nav class="site-nav" aria-label="主导航">
      {
        links.map((link) => (
          <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <button
      type="button"
      class="theme-toggle"
      data-theme-toggle
      aria-label="切换深浅色主题"
      title="切换深浅色主题"
    >
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linejoin="round"></path>
      </svg>
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6"></circle>
        <path
          d="M12 2v2M12 20v2M4.6 4.6 6 6M18 18l1.4 1.4M2 12h2M20 12h2M4.6 19.4 6 18M18 6l1.4-1.4"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
</header>
