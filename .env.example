APP_ENV=development
HTTP_ADDR=:8080
RUN_MIGRATIONS=true
SHUTDOWN_TIMEOUT=10s

# PostgreSQL
POSTGRES_USER=twilightlog
POSTGRES_PASSWORD=change_me
POSTGRES_DB=twilightlog
POSTGRES_PORT=5432
DATABASE_URL=postgres://twilightlog:change_me@localhost:5432/twilightlog?sslmode=disable

# Auth
# 至少 32 位随机字符串，生产环境必须替换
JWT_SECRET=replace_with_at_least_32_random_characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
REFRESH_TOKEN_TTL_SHORT=24h
# 生产环境走 HTTPS 时必须为 true
COOKIE_SECURE=false
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:4321,http://localhost:5173

# Storage
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=var/uploads
ASSET_BASE_URL=http://localhost:8080/assets

# Docker images（可选：本地无法访问 Docker Hub 时改成国内镜像）
# GO_IMAGE=docker.m.daocloud.io/library/golang:1.27-alpine
# RUNTIME_IMAGE=docker.m.daocloud.io/library/alpine:3.22
# CADDY_IMAGE=docker.m.daocloud.io/library/caddy:2-alpine
# POSTGRES_IMAGE=postgres:16-alpine
# GOPROXY=https://goproxy.cn,direct
# GOSUMDB=sum.golang.google.cn

# Origins
PUBLIC_ORIGIN=http://localhost:4321
ADMIN_ORIGIN=http://localhost:5173

# OSS / FC（阶段 3 前补齐）
OSS_ENDPOINT=
OSS_REGION=
OSS_PRIVATE_BUCKET=
OSS_PUBLIC_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
FC_ENDPOINT=
